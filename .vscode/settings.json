{
    "java.test.defaultConfig": "tests",
    "java.test.config": [
        {
            "name": "tests",
            "modulePaths": ["${workspaceFolder}/cascara-common/modulepath"],
            "module": "cascara.common",
        },
        {
            "name": "modular-tests",
            "modulePaths": ["${workspaceFolder}/cascara-common-test/modulepath"],
            "module": "cascara.common.test",
        },
    ],

    "java.project.referencedLibraries": [
        "cascara-common/build/classes/java/main"
      ],
      "java.configuration.updateBuildConfiguration": "automatic",
      "java.eclipse.downloadSources": true,

    "java.configuration.detectJpms": false,
    "java.compile.nullAnalysis.mode": "disabled",
    "java.jdt.ls.vmargs": "-XX:+UseParallelGC -XX:GCTimeRatio=4 -XX:AdaptiveSizePolicyWeight=90 -Dsun.zip.disableMemoryMapping=true",
}